# CodeRadar index
.coderadar/

# Rust build artifacts
/target/
**/*.rs.bk

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Compiled extension (built via maturin; rebuild with `maturin develop`)
*.so
*.pyd

# Packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Runtime caches
.web_research_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
crash.log

# Scratch artifacts
step1_links.json
wiki_topics.json

# Windows device-name artifact (prevents accidental indexing)
nul
