{
  "schema": "rust-anything/app-cases@1",
  "name": "gossamer",
  "run": [
    ".venv/Scripts/python.exe",
    "rust/original_entry.py"
  ],
  "normalize": [
    "key-order",
    "timestamps"
  ],
  "normalizers": {
    "bench-ms": "[0-9]+\\.[0-9]+ms",
    "bench-p50p95": "[0-9]+\\.[0-9]+ / [0-9]+\\.[0-9]+",
    "bench-speedup": "[0-9]+\\.[0-9]+x"
  },
  "timeout_secs": 60,
  "fresh": [
    "rust/fixtures",
    "tests/fixtures/guard_corpus"
  ],
  "unordered": {
    "audit-cargo-empty-lock": [
      "stdout",
      "stderr"
    ],
    "verify-bundled-assets-bad-whl": [
      "stdout",
      "stderr"
    ],
    "verify-bundled-assets-missing-whl": [
      "stdout",
      "stderr"
    ],
    "verify-bundled-assets-good-whl": [
      "stdout",
      "stderr"
    ],
    "verify-bundled-assets-good-targz": [
      "stdout",
      "stderr"
    ],
    "cache-prune": [
      "stdout",
      "stderr"
    ],
    "verify-bundled-assets-mixed-unsupported": [
      "stdout",
      "stderr"
    ],
    "skills-show": [
      "stdout",
      "stderr"
    ],
    "skills-install-duplicate-skill": [
      "stdout",
      "stderr"
    ]
  }
}
