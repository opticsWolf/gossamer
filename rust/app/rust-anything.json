{
  "schema": "rust-anything/front-door@1",
  "name": "gossamer",
  "commands": [
    "batch",
    "cache",
    "categories",
    "check",
    "cite",
    "crawl",
    "discover",
    "download",
    "extract",
    "inspect",
    "locate-pdf",
    "research",
    "search",
    "skills",
    "audit-cargo",
    "verify-bundled-assets"
  ],
