    {
      "name": "verify-bundled-assets",
      "crate": "verify-bundled-assets-rs",
      "path": "../verify-bundled-assets-rs",
      "commands": [
        "verify-bundled-assets"
      ],
      "switch": "RUST_ANYTHING_UNIT_VERIFY_BUNDLED_ASSETS"
    }
  ]
