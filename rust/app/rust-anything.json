{
  "schema": "rust-anything/front-door@1",
  "name": "gossamer",
  "commands": [
    "batch",
    "benchmarks",
    "cache",
    "categories",
    "check",
    "cite",
    "crawl",
    "discover",
    "download",
    "extract",
    "inspect",
    "locate-pdf",
