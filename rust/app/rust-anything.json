    },
    {
      "name": "inspect",
      "crate": "gossamer",
      "path": "../core",
      "commands": ["inspect"],
      "switch": "RUST_ANYTHING_UNIT_INSPECT"
    },
    {
      "name": "batch",
      "crate": "gossamer",
      "path": "../core",
      "commands": ["batch"],
      "switch": "RUST_ANYTHING_UNIT_BATCH"
    },
    {
      "name": "cache",
      "crate": "gossamer",
      "path": "../core",
      "commands": [
        "cache"
      ],
      "switch": "RUST_ANYTHING_UNIT_CACHE"
    },
    {
      "name": "benchmarks",
      "crate": "benchmarks-rs",
      "path": "../benchmarks-rs",
      "commands": [
        "benchmarks"
      ],
      "switch": "RUST_ANYTHING_UNIT_BENCHMARKS"
    },
    {
      "name": "skills",
      "crate": "skills-rs",
      "path": "../skills-rs",
      "commands": [
        "skills"
      ],
      "switch": "RUST_ANYTHING_UNIT_SKILLS"
